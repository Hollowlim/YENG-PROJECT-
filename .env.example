# The project public defaults are in site-config.js.
# Copy to .env.local only to override them; both empty explicitly selects demo mode.
# These are public browser-safe settings, never a service-role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Installer-only React Bits Pro license; never prefix with VITE_ or commit a value.
REACTBITS_LICENSE_KEY=
